#include <stdio.h>

int main()
{
    float weight, height, bmi;

    printf("Enter Weight (kg): ");
    scanf("%f", &weight);

    printf("Enter Height (m): ");
    scanf("%f", &height);

    bmi = weight / (height * height);

    printf("\n===== BMI RESULT =====\n");
    printf("BMI = %.2f\n", bmi);

    if (bmi < 18.5)
        printf("Health Status: Underweight\n");
    else if (bmi >= 18.5 && bmi < 25.0)
        printf("Health Status: Normal Weight\n");
    else if (bmi >= 25.0 && bmi < 30.0)
        printf("Health Status: Overweight\n");
    else
        printf("Health Status: Obese\n");

    return 0;
}
